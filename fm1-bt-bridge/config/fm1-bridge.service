[Unit]
Description=FM-1 Bluetooth bridge (OLED HAT)
After=pipewire.service wireplumber.service
Wants=pipewire.service wireplumber.service

[Service]
WorkingDirectory=%h/.local/share/fm1-bridge
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 %h/.local/share/fm1-bridge/bridge.py
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
